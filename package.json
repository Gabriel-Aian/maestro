{
  "name": "maestro-core",
  "version": "0.3.0",
  "description": "Núcleo de automação web do Maestro — gravador, replay e motor de pesquisas",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "cli": "node dist/cli.js",
    "electron:typecheck": "tsc -p electron/tsconfig.node.json && tsc -p electron/tsconfig.web.json",
    "electron:dev": "electron-vite dev",
    "electron:build": "electron-vite build",
    "electron:preview": "electron-vite preview",
    "package:win": "npm run build && npm run electron:build && electron-builder --win --publish=never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "commander": "^15.0.0",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "type": "module",
  "main": "out/main/index.js",
  "bin": {
    "maestro": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "exports": {
    ".": "./dist/index.js"
  }
}
